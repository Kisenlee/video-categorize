{
  "name": "video-classifier",
  "version": "1.0.2",
  "description": "Windows desktop helper for classifying local / NAS videos",
  "main": "./out/main/index.js",
  "author": "video-classifier",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "fetch:mpv": "node scripts/fetch-mpv.mjs",
    "dist:win": "npm run fetch:mpv && npm run build && electron-builder --win --x64",
    "test:classify": "node scripts/test-classify.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.videoclassifier.app",
    "productName": "VideoClassifier",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "vendor/mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VideoClassifier-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "VideoClassifier-${version}-portable.exe"
    }
  },
  "allowScripts": {
    "koffi@2.16.3": true
  }
}
